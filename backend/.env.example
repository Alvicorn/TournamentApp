# Copy to .env and fill in. See docs/deployment.md#environment-configuration.

ENVIRONMENT=development

# Supabase (Postgres + admin auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key
DATABASE_URL=postgresql+psycopg://postgres:password@db.your-project.supabase.co:5432/postgres

# Judge sessions (HS256)
JUDGE_JWT_SECRET=change-me

# Admin access
ADMIN_EMAIL_ALLOWLIST=admin@example.com

# Web push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# CORS (JSON list) — frontend dev server origin
CORS_ALLOW_ORIGINS=["http://localhost:8080"]
